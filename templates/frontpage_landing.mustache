{{!
    @template theme_synergylearning/frontpage_landing

    MyLearning landing sections for the site home: hero (log in / welcome back), course catalogue and about.
    Markup and behaviour are the Task 1 page, adapted to real Moodle data and strings.

    Context variables required for this template:
    * hero - Site name, banner image and either log in form data or the signed-in user's first name
    * catalogue - Top-level course categories visible to the user
    * about - Video poster and video URL

    Example context (json):
    {
        "hero": {
            "sitefullname": "MyLearning",
            "isloggedin": false,
            "loginurl": "https://example.com/login/index.php",
            "logintoken": "abc123",
            "forgotpasswordurl": "https://example.com/login/forgot_password.php",
            "contacturl": "https://example.com/user/contactsitesupport.php",
            "banner": {"src": "banner-1000.jpg", "srcset": "banner-640.jpg 640w, banner-1000.jpg 1000w"}
        },
        "catalogue": {
            "hascategories": true,
            "allurl": "https://example.com/course/index.php",
            "categories": [
                {"id": 1, "name": "Optics and Manufacturing", "url": "#", "iconurl": "optics.svg",
                 "srlabel": "View courses in Optics and Manufacturing"}
            ]
        },
        "about": {"poster": "poster.jpg", "videourl": "video.mp4"}
    }
}}
<div class="sl-landing-sections" id="sl-landing" tabindex="-1" data-region="sl-landing">

    {{! ============================== Hero ============================== }}
    {{#hero}}
    <section class="sl-hero" aria-labelledby="sl-hero-title-{{uniqid}}">
        <div class="row g-0 sl-hero__row">
            <div class="col-lg-6 sl-hero__panel">
                <div class="sl-hero__form-wrap">
                    {{^isloggedin}}
                    <h1 id="sl-hero-title-{{uniqid}}" class="sl-hero__title">
                        <span class="sl-hero__eyebrow">{{#str}}welcome, theme_synergylearning{{/str}}</span>
                        {{sitefullname}}
                    </h1>

                    <form class="sl-login" action="{{loginurl}}" method="post" id="sl-login" novalidate data-region="sl-login"
                          data-loggingin="{{#str}}loggingin, theme_synergylearning{{/str}}"
                          data-showpassword="{{#str}}showpassword, theme_synergylearning{{/str}}"
                          data-hidepassword="{{#str}}hidepassword, theme_synergylearning{{/str}}">
                        <input type="hidden" name="logintoken" value="{{logintoken}}">
                        <input type="hidden" name="anchor" value="">

                        <div class="sl-login__field">
                            <label for="sl-username" class="form-label">{{#str}}username, core{{/str}}</label>
                            <input type="text" class="form-control" id="sl-username" name="username"
                                   autocomplete="username" autocapitalize="none" spellcheck="false" required
                                   aria-describedby="sl-username-error">
                            <div class="invalid-feedback" id="sl-username-error">{{#str}}loginrequired_username, theme_synergylearning{{/str}}</div>
                        </div>

                        <div class="sl-login__field">
                            <label for="sl-password" class="form-label">{{#str}}password, core{{/str}}</label>
                            <div class="sl-password">
                                <input type="password" class="form-control" id="sl-password" name="password"
                                       autocomplete="current-password" required
                                       aria-describedby="sl-password-error sl-capslock">
                                <button type="button" class="sl-password__toggle" data-action="sl-toggle-password"
                                        aria-controls="sl-password" aria-pressed="false" hidden>
                                    <svg class="sl-icon-eye" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path fill="currentColor" d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                                    <svg class="sl-icon-eye-off" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/><path fill="currentColor" d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/><path fill="currentColor" d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/></svg>
                                    <span class="visually-hidden" data-region="sl-toggle-label">{{#str}}showpassword, theme_synergylearning{{/str}}</span>
                                </button>
                            </div>
                            <div class="invalid-feedback" id="sl-password-error">{{#str}}loginrequired_password, theme_synergylearning{{/str}}</div>
                            <p class="sl-capslock" id="sl-capslock" hidden>{{#str}}capslockon, theme_synergylearning{{/str}}</p>
                        </div>

                        <button type="submit" class="btn btn-primary sl-login__submit w-100" data-region="sl-login-submit">
                            <svg class="sl-btn-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11.743 6.297c.07-.157.07-.367 0-.594-.07-.07-.07-.14-.14-.21L6.506.398C6.226.1 5.791.1 5.494.397c-.297.297-.297.733 0 1.012L9.35 5.267H.903c-.436 0-.715.297-.715.733s.279.733.715.733h8.448l-3.857 3.84a.707.707 0 000 1.03c.14.14.366.21.506.21s.367-.07.506-.21l5.097-5.097c.07-.07.14-.14.14-.21z"/></svg>
                            <span data-region="sl-login-label">{{#str}}login, core{{/str}}</span>
                        </button>

                        <div class="sl-login__links">
                            {{#contacturl}}<a href="{{contacturl}}">{{#str}}contactus, theme_synergylearning{{/str}}</a>{{/contacturl}}
                            <a href="{{forgotpasswordurl}}" class="ms-auto">{{#str}}lostpassword, theme_synergylearning{{/str}}</a>
                        </div>

                        {{#hasidentityproviders}}
                        <div class="sl-login__idps">
                            <p class="sl-login__idps-label">{{#str}}potentialidps, auth{{/str}}</p>
                            {{#identityproviders}}
                                <a class="btn btn-outline-dark w-100 mb-2" href="{{url}}">
                                    {{#iconurl}}<img src="{{iconurl}}" alt="" width="24" height="24" class="me-1">{{/iconurl}}
                                    {{name}}
                                </a>
                            {{/identityproviders}}
                        </div>
                        {{/hasidentityproviders}}
                    </form>
                    {{/isloggedin}}

                    {{#isloggedin}}
                    <h1 id="sl-hero-title-{{uniqid}}" class="sl-hero__title">
                        <span class="sl-hero__eyebrow">{{sitefullname}}</span>
                        {{#str}}welcomeback, theme_synergylearning, {{firstname}}{{/str}}
                    </h1>
                    <div class="sl-hero__actions">
                        <a class="btn btn-primary sl-login__submit w-100" href="{{dashboardurl}}">
                            <svg class="sl-btn-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11.743 6.297c.07-.157.07-.367 0-.594-.07-.07-.07-.14-.14-.21L6.506.398C6.226.1 5.791.1 5.494.397c-.297.297-.297.733 0 1.012L9.35 5.267H.903c-.436 0-.715.297-.715.733s.279.733.715.733h8.448l-3.857 3.84a.707.707 0 000 1.03c.14.14.366.21.506.21s.367-.07.506-.21l5.097-5.097c.07-.07.14-.14.14-.21z"/></svg>
                            {{#str}}gotodashboard, theme_synergylearning{{/str}}
                        </a>
                        <a class="sl-hero__secondary" href="{{catalogueurl}}">{{#str}}catalogue_viewall, theme_synergylearning{{/str}}</a>
                    </div>
                    {{/isloggedin}}
                </div>
            </div>

            <div class="col-lg-6 sl-hero__media">
                {{#banner}}
                <img src="{{src}}" srcset="{{srcset}}" sizes="(min-width: 992px) 50vw, 100vw"
                     width="2400" height="1200" fetchpriority="high"
                     alt="{{#str}}banner_alt, theme_synergylearning{{/str}}">
                {{/banner}}
            </div>
        </div>
    </section>
    {{/hero}}

    {{! ============================== Catalogue ============================== }}
    {{#catalogue}}
    {{#hascategories}}
    <section id="catalogue" class="sl-catalogue" aria-labelledby="sl-catalogue-title-{{uniqid}}">
        <div class="container">
            <div class="sl-section-title">
                <h2 id="sl-catalogue-title-{{uniqid}}">{{#str}}catalogue_title, theme_synergylearning{{/str}}</h2>
                <a href="{{allurl}}" class="sl-section-title__link">{{#str}}catalogue_viewall, theme_synergylearning{{/str}}</a>
            </div>

            <ul class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-4 list-unstyled sl-catalogue__grid">
                {{#categories}}
                <li class="col" data-sl-reveal>
                    <article class="sl-card">
                        <h3 class="sl-card__title">{{{name}}}</h3>
                        <img class="sl-card__icon{{#customicon}} sl-card__icon--custom{{/customicon}}" src="{{iconurl}}" alt="" width="72" height="72" loading="lazy">
                        <a class="btn sl-card__btn stretched-link" href="{{url}}">
                            <svg class="sl-btn-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11.743 6.297c.07-.157.07-.367 0-.594-.07-.07-.07-.14-.14-.21L6.506.398C6.226.1 5.791.1 5.494.397c-.297.297-.297.733 0 1.012L9.35 5.267H.903c-.436 0-.715.297-.715.733s.279.733.715.733h8.448l-3.857 3.84a.707.707 0 000 1.03c.14.14.366.21.506.21s.367-.07.506-.21l5.097-5.097c.07-.07.14-.14.14-.21z"/></svg>
                            <span aria-hidden="true">{{#str}}viewcourses, theme_synergylearning{{/str}}</span>
                            <span class="visually-hidden">{{{srlabel}}}</span>
                        </a>
                    </article>
                </li>
                {{/categories}}
            </ul>
        </div>
    </section>
    {{/hascategories}}
    {{/catalogue}}

    {{! ============================== About / video ============================== }}
    {{#about}}
    <section class="sl-about" aria-labelledby="sl-about-title-{{uniqid}}">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 offset-lg-2 col-md-10 offset-md-1">
                    <figure class="sl-video" data-sl-reveal>
                        <div class="sl-video__frame" data-region="sl-video" data-src="{{videourl}}"
                             data-title="{{#str}}about_title, theme_synergylearning{{/str}}"
                             data-unavailable="{{#str}}video_unavailable, theme_synergylearning{{/str}}"
                             data-unavailabledesc="{{#str}}video_unavailable_desc, theme_synergylearning{{/str}}">
                            <img class="sl-video__poster" src="{{poster}}" width="635" height="254" alt="" loading="lazy">
                            <button type="button" class="sl-video__play" data-action="sl-play-video">
                                <span class="sl-video__play-icon" aria-hidden="true"></span>
                                <span class="sl-video__play-label">
                                    {{#str}}video_play, theme_synergylearning{{/str}}<span class="visually-hidden">: {{#str}}about_title, theme_synergylearning{{/str}},</span>
                                    <span class="sl-video__duration">{{#str}}video_duration, theme_synergylearning{{/str}}</span>
                                </span>
                            </button>
                        </div>
                    </figure>
                    <h2 id="sl-about-title-{{uniqid}}" class="sl-about__title">{{#str}}about_title, theme_synergylearning{{/str}}</h2>
                    <p class="sl-about__text">{{#str}}about_text, theme_synergylearning{{/str}}</p>
                </div>
            </div>
        </div>
    </section>
    {{/about}}
</div>
