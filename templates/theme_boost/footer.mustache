{{!
    @template theme_boost/footer

    Page footer (overridden by theme_synergylearning).

    Boost's footer is kept unchanged so its help pop-over, support links and debugging output still work.
    A branded band is added at the top showing, in this order, each only when its setting has a value:
    * the Contact button (an icon is added for tel: and mailto: links);
    * the address;
    * the footer links;
    * the Cookie settings button, which opens the Cookie settings pop-up added with the band;
    * additional footer content (free rich text);
    * then, at the very bottom, the footer logo (the theme's "Footer logo" setting, falling back to
      core_admin | logocompact) and the copyright text, with the © symbol prepended statically.

    Example context (json):
    {
        "output": {
            "page_doc_link": "Documentation for this page",
            "supportemail": "<a href=\"#\">Contact site support</a>",
            "has_popover_links": true,
            "services_support": "Services and support",
            "login_info": "You are logged in as cute kitten",
            "moodle_release": "90210",
            "has_communication_links": true,
            "communication_url": "https://element:8081/#/room/#yourroom:synapse",
            "communication_link": "<a href=\"#\">Communication room</a>",
            "footer_brand": {
                "logourl": "https://example.com/pluginfile.php/1/theme_synergylearning/footerlogo/1/logo.png",
                "logoalt": "MyLearning",
                "copyright": "2026 Nikon Optical Ltd. All rights reserved.",
                "contact": {"label": "Contact us", "url": "tel:+441632960000", "icon": "fa-phone", "via": "by phone"},
                "address": {"firstline": "Nikon Optical Ltd", "lines": ["3 Tanners Drive", "United Kingdom"]},
                "haslinks": true,
                "links": [{"label": "Policies", "url": "https://example.com/admin/tool/policy/viewall.php"}],
                "cookiebutton": true,
                "content": ""
            }
        }
    }
}}

<footer id="page-footer" class="footer-popover bg-white">
    {{#output.footer_brand}}
    <div class="sl-footer" id="contact" data-region="sl-footer">
        <div class="sl-footer__inner">
            {{! One column: the contact button, address, links, cookie button and any extra content, then the logo
                and copyright at the very bottom. Each part is left out when its setting is empty. Text values are
                already escaped by format_string() in the renderer, hence the triple braces. }}
            {{#contact}}
                <a class="btn btn-primary sl-footer__contact" href="{{url}}">
                    <i class="icon fa {{icon}} fa-fw" aria-hidden="true"></i>{{{label}}}{{#via}}<span class="visually-hidden"> {{via}}</span>{{/via}}
                </a>
            {{/contact}}
            {{#address}}
                <address class="sl-footer__address">
                    <strong>{{{firstline}}}</strong>{{#lines}}<br>{{{.}}}{{/lines}}
                </address>
            {{/address}}
            {{#haslinks}}
                <ul class="sl-footer__links list-unstyled">
                    {{#links}}
                        <li><a href="{{url}}">{{{label}}}</a></li>
                    {{/links}}
                </ul>
            {{/haslinks}}
            {{#cookiebutton}}
                {{! Hidden until amd/src/footer.js is ready to open the pop-up, as it does nothing without JavaScript. }}
                <button type="button" class="btn btn-sl-cookie" data-action="sl-cookie-settings" hidden>
                    {{#str}}cookiesettings, theme_synergylearning{{/str}}
                </button>
            {{/cookiebutton}}
            {{#content}}
                <div class="sl-footer__content">
                    {{{content}}}
                </div>
            {{/content}}
            <div class="sl-footer__brand">
                {{#logourl}}
                    <img class="sl-footer__logo" src="{{logourl}}" alt="{{logoalt}}">
                {{/logourl}}
                {{#copyright}}
                    <p class="sl-footer__copyright">&copy; {{{copyright}}}</p>
                {{/copyright}}
            </div>
        </div>
    </div>
        {{! Cookie settings pop-up, opened by the Cookie settings button (see amd/src/footer.js). A .btn-sl-cookie
            button in the additional footer content opens it too. }}
        <div class="modal fade" id="cookie-modal" tabindex="-1" aria-labelledby="cookie-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" data-cookie-form>
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="cookie-modal-title">{{#str}}cookiesettings, theme_synergylearning{{/str}}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, core{{/str}}"></button>
                    </div>
                    <div class="modal-body">
                        <p>{{#str}}cookie_intro, theme_synergylearning, {{logoalt}}{{/str}}</p>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="cookie-essential" checked disabled>
                            <label class="form-check-label" for="cookie-essential">
                                <strong>{{#str}}cookie_essential, theme_synergylearning{{/str}}</strong> – {{#str}}cookie_essential_desc, theme_synergylearning{{/str}}
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="cookie-analytics" name="analytics">
                            <label class="form-check-label" for="cookie-analytics">
                                <strong>{{#str}}cookie_analytics, theme_synergylearning{{/str}}</strong> – {{#str}}cookie_analytics_desc, theme_synergylearning{{/str}}
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{#str}}cancel, core{{/str}}</button>
                        <button type="submit" class="btn btn-primary">{{#str}}cookie_save, theme_synergylearning{{/str}}</button>
                    </div>
                </form>
            </div>
        </div>
    {{/output.footer_brand}}
    <div data-region="footer-container-popover">
        {{#output.has_communication_links}}
            <button onclick="window.open('{{output.communication_url}}', '_blank', 'noreferrer')" class="btn btn-icon rounded-circle bg-primary text-white btn-footer-communication" aria-label="{{#str}}communicationroomlink, course{{/str}}">
                {{#pix}}t/messages-o, core{{/pix}}
            </button>
        {{/output.has_communication_links}}
        <button class="btn btn-icon rounded-circle text-bg-secondary btn-footer-popover" data-action="footer-popover" aria-label="{{#str}}showfooter, theme_boost{{/str}}">
            {{#pix}}e/question, core{{/pix}}
        </button>
    </div>
    <div class="footer-content-popover container" data-region="footer-content-popover">
        {{#output.has_communication_links}}
            <div class="footer-section p-3 border-bottom footer-link-communication">
                <div class="footer-support-link">{{{ output.communication_link }}}</div>
            </div>
        {{/output.has_communication_links}}
        {{# output.has_popover_links }}
            <div class="footer-section p-3 border-bottom">
                {{# output.page_doc_link }}
                    <div class="footer-support-link">{{{ output.page_doc_link }}}</div>
                {{/ output.page_doc_link }}

                {{# output.services_support_link }}
                    <div class="footer-support-link">{{{ output.services_support_link }}}</div>
                {{/ output.services_support_link }}

                {{# output.supportemail }}
                    <div class="footer-support-link">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}
            </div>
        {{/ output.has_popover_links }}
        <div class="footer-section p-3 border-bottom">
            <div class="logininfo">
                {{{ output.login_info }}}
            </div>
            <div class="tool_usertours-resettourcontainer">
            </div>
            {{# output.telemetry_traceid }}
                <div>
                    <span id="telemetry_traceid" class="d-none">
                        {{{ output.telemetry_traceid }}}
                    </span>
                    <a href="#" data-action="copytoclipboard" data-clipboard-target="#telemetry_traceid"
                            data-clipboard-success-message="{{#str}}telemetrytraceidfooterlinkcopied, core{{/str}}">
                        {{#str}}telemetrytraceidfooterlink, core{{/str}}
                    </a>
                </div>
            {{/ output.telemetry_traceid }}
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
        <div class="footer-section p-3">
            <div>{{#str}}poweredbymoodle, core{{/str}}</div>
            {{#output.moodle_release}}
                <div>
                    {{#str}}version, core{{/str}} {{{ output.moodle_release }}}
                </div>
            {{/output.moodle_release}}
        </div>
    </div>

    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
{{#js}}
require(['theme_synergylearning/footer'], (m) => m.init());
require(['theme_synergylearning/navbar'], (m) => m.init());
require(['theme_synergylearning/login'], (m) => m.init());

require([
    'theme_boost/footer-popover',
    'core/copy_to_clipboard',
], function(FooterPopover) {
    FooterPopover.init();
});
{{/js}}
